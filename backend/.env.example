NODE_ENV=development
PORT=4010
FRONTEND_URL=http://localhost:8100
FRONTEND_URLS=http://localhost:8100,http://localhost:8101
FRONTEND_URL_PATTERNS=http://*:*,https://*:*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=computron
DB_USER=postgres
DB_PASSWORD=root12345
DB_SSL=false

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7
RECEIPT_TOKEN_ENCRYPTION_KEY=replace_with_secure_receipt_token_key

SMTP_HOST=smtp.hostgator.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=password_smtp
SMTP_FROM=no-reply@tudominio.com

PERMISSION_CACHE_TTL_MS=30000
RESPONSE_CACHE_TTL_MS=900000
RESPONSE_CACHE_MAX_ENTRIES=500
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_MAX_QUEUE=200
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000

# API externa SUNAT (yorchavez9/Api-de-facturacion-electronica-sunat-Peru)
# Levanta esa API aparte y coloca aquí su URL base y token Sanctum.
SUNAT_API_BASE_URL=
SUNAT_API_TOKEN=
SUNAT_API_COMPANY_ID=
SUNAT_API_BRANCH_ID=
SUNAT_API_BOLETA_SERIE=B001
SUNAT_API_FACTURA_SERIE=F001
SUNAT_API_BOLETA_METODO_ENVIO=resumen_diario
SUNAT_API_DEFAULT_UNIT=ZZ
SUNAT_API_DEFAULT_ITEM_CODE=SERV
SUNAT_API_PRODUCT_SUNAT_CODE=
SUNAT_API_DEFAULT_UBIGEO=
SUNAT_API_DEFAULT_DISTRITO=
SUNAT_API_DEFAULT_PROVINCIA=
SUNAT_API_DEFAULT_DEPARTAMENTO=
SUNAT_API_TAX_PERCENT=0
SUNAT_API_IGV_AFFECTATION=30
SUNAT_API_PRICES_INCLUDE_IGV=true
SUNAT_API_TIMEOUT_MS=20000
